# KHARIS & ALETHEIA — deployment config.
# Copy this file to `.env` (same folder as docker-compose.yml) and fill in real
# values, then run `docker compose up -d --build`. Docker Compose loads `.env`
# automatically. Every value here is optional — anything left blank falls back
# to the placeholder baked into web/lib/config.ts.
#
# IMPORTANT: these are Next.js NEXT_PUBLIC_* variables — they get compiled
# into the app at BUILD time, not read at container start. Changing a value
# in `.env` requires `docker compose up -d --build` (not just `restart`) to
# take effect.

# Owner's real inbox — used for the mailto: fallback on contact/bulk/gift
# forms and for order notices. Placeholder: hello@kharisandaletheia.com
NEXT_PUBLIC_CONTACT_EMAIL=

# Optional HTTPS POST endpoint (e.g. Formspree) that contact/bulk forms submit
# to instead of a mailto: link. Must start with https:// — anything else is
# ignored and the site falls back to mailto:. Leave blank to always use mailto:.
NEXT_PUBLIC_FORM_ENDPOINT=

# 'request' (default) emails every order to NEXT_PUBLIC_CONTACT_EMAIL for
# manual processing. Set to 'paystack' once a real Paystack account + public
# key exist below.
NEXT_PUBLIC_PAYMENT_PROVIDER=

# Paystack public key — only used when NEXT_PUBLIC_PAYMENT_PROVIDER=paystack.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# Canonical site URL — used for JSON-LD / canonical link tags / share links.
# Placeholder: https://www.kharisandaletheia.com
NEXT_PUBLIC_SITE_URL=
